# Copy only placeholder values into a local environment. Never place Production
# credentials, Firebase targets, real Resend keys, or customer data here.
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
EMAIL_TRANSPORT=fake
EMAIL_WEBHOOK_ENABLED=false

# Legacy Firebase is forced to these local emulators until it is removed.
FIREBASE_EMULATOR_ENABLED=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gioia-beauty
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=127.0.0.1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-gioia-beauty.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Local Supabase uses loopback only. The local adapter connects as the disposable
# local postgres user and immediately SET LOCAL ROLE app_runtime in every
# transaction. Preview/Production must instead use the dedicated app_runtime
# login through the transaction pooler; privileged postgres URLs are rejected.
# Keep CLI status/key output out of logs and untracked env files only.
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-placeholder
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Synthetic local-only HMAC material. Remote environments require a unique
# server-only value with at least 32 bytes; never prefix it with NEXT_PUBLIC_.
BOOKING_HMAC_SECRET=local-test-only-booking-hmac-secret-000000000000
OWNER_SESSION_HMAC_SECRET=local-test-only-owner-session-secret-000000000

# Synthetic owner identity for emulator/local tests only.
BOOKING_ADMIN_EMAIL=owner@example.test
