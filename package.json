{
  "name": "gioia_beauty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next dev",
    "build": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next build",
    "build:profile": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next build --profile",
    "build:cpu-profile": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next build --experimental-cpu-prof",
    "analyze": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next experimental-analyze --output",
    "start": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next start",
    "typegen": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} next typegen",
    "typecheck": "npm run typegen && tsc --noEmit --pretty false",
    "typecheck:ts6": "npm run typegen && tsc6 --noEmit --pretty false --stableTypeOrdering",
    "catalog:sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/render-catalog-sql.mjs",
    "migration:preflight": "node scripts/migration-preflight.mjs",
    "lint": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-${APP_ENV:-local}} APP_ENV=${APP_ENV:-local} eslint . --max-warnings=0",
    "format": "prettier --write .github app/api config lib/client lib/domain lib/server scripts tests eslint.config.mjs proxy.ts next.config.mjs playwright.config.ts playwright.preview.config.ts playwright.performance.config.ts vitest.config.mjs tsconfig.json package.json README.md",
    "format:check": "prettier --check .github app/api config lib/client lib/domain lib/server scripts tests eslint.config.mjs proxy.ts next.config.mjs playwright.config.ts playwright.preview.config.ts playwright.performance.config.ts vitest.config.mjs tsconfig.json package.json README.md",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:migration:new": "SUPABASE_TELEMETRY_DISABLED=1 supabase migration new",
    "db:static": "node scripts/check-supabase-sql.mjs",
    "db:start": "SUPABASE_TELEMETRY_DISABLED=1 supabase start --exclude edge-runtime,imgproxy,logflare,realtime,storage-api,vector",
    "db:start:ci": "bash scripts/start-ci-database.sh",
    "db:health": "SUPABASE_TELEMETRY_DISABLED=1 supabase db query --local --output json 'select 1 as healthy'",
    "db:reset": "SUPABASE_TELEMETRY_DISABLED=1 supabase db reset --local",
    "db:seed:replay": "node scripts/replay-local-seed.mjs",
    "db:migrations": "SUPABASE_TELEMETRY_DISABLED=1 supabase migration list --local",
    "db:lint": "SUPABASE_TELEMETRY_DISABLED=1 supabase db lint --local --schema gioia_private --level warning --fail-on warning",
    "db:advisors": "SUPABASE_TELEMETRY_DISABLED=1 supabase db advisors --local --type all --level warn --fail-on warn",
    "db:test": "node scripts/test-local-pgtap.mjs",
    "db:test:seed-auth": "node scripts/test-local-auth-seed.mjs",
    "db:test:auth-routes": "node scripts/test-local-owner-auth-routes.mjs",
    "db:test:concurrency": "node scripts/test-booking-concurrency.mjs",
    "db:test:migration-rehearsal": "GIOIA_RUN_LOCAL_MIGRATION_REHEARSAL=1 EMAIL_TRANSPORT=fake NEXT_PUBLIC_APP_ENV=test APP_ENV=test vitest run tests/integration/legacy-migration-local.test.ts",
    "db:test:reverse-rehearsal": "GIOIA_RUN_LOCAL_MIGRATION_REHEARSAL=1 EMAIL_TRANSPORT=fake NEXT_PUBLIC_APP_ENV=test APP_ENV=test vitest run tests/integration/legacy-firestore-reverse-local.test.ts",
    "db:test:phase5-recovery": "npm run db:reset && npm run db:test:migration-rehearsal && npm run db:test:reverse-rehearsal && APP_ENV=test NEXT_PUBLIC_APP_ENV=test EMAIL_TRANSPORT=fake node scripts/test-local-postgres-recovery.mjs",
    "db:test:greenfield": "node scripts/test-greenfield-project.mjs",
    "db:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop --project-id gioia-beauty-local",
    "db:clean": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop --project-id gioia-beauty-local --no-backup",
    "test": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-test} APP_ENV=${APP_ENV:-test} vitest run",
    "test:guarded-manifest": "GIOIA_RUN_GUARDED_MANIFEST=1 EMAIL_TRANSPORT=fake NEXT_PUBLIC_APP_ENV=test APP_ENV=test vitest run tests/server/test-target-migrations.test.js",
    "test:watch": "EMAIL_TRANSPORT=${EMAIL_TRANSPORT:-fake} NEXT_PUBLIC_APP_ENV=${NEXT_PUBLIC_APP_ENV:-test} APP_ENV=${APP_ENV:-test} vitest",
    "test:booking:timezones": "TZ=America/New_York EMAIL_TRANSPORT=fake NEXT_PUBLIC_APP_ENV=test APP_ENV=test vitest run tests/domain/booking && TZ=Asia/Tokyo EMAIL_TRANSPORT=fake NEXT_PUBLIC_APP_ENV=test APP_ENV=test vitest run tests/domain/booking",
    "test:e2e": "npm run test:e2e:phase3 && npm run test:e2e:phase4",
    "test:e2e:phase3": "playwright test --project=phase3-api",
    "test:e2e:phase4": "playwright test --project=phase4-public --project=phase4-owner",
    "test:e2e:preview": "node scripts/test-preview-phase4.mjs",
    "test:performance": "npm run build && playwright test --config=playwright.performance.config.ts",
    "test:performance:run": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "security:secrets": "./scripts/check-secrets.sh",
    "security:dependencies": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/render": "2.1.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-phone-input-2": "^2.15.1",
    "react-toastify": "^11.1.0",
    "resend": "^6.18.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "svix": "1.99.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "lint-staged": "17.2.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "app/api/**/*.{js,mjs,ts}": "prettier --write",
    "config/**/*.{js,mjs,ts}": "prettier --write",
    "lib/{client,domain,server}/**/*.{js,mjs,ts}": "prettier --write",
    "tests/**/*.{js,jsx,mjs,ts,tsx}": "prettier --write",
    "proxy.ts": "prettier --write",
    "*.{md,mjs}": "prettier --write",
    "package.json": "prettier --write"
  },
  "overrides": {
    "@babel/runtime": "7.29.7",
    "brace-expansion": "5.0.8",
    "cross-spawn": "7.0.6",
    "fast-xml-parser": "5.10.1",
    "js-beautify": {
      "glob": "10.5.0"
    },
    "rimraf@5.0.10": {
      "glob": "10.5.0"
    },
    "sucrase": {
      "glob": "10.5.0"
    },
    "js-cookie@3.0.5": "3.0.8",
    "jws@3.2.2": "3.2.3",
    "minimatch": "10.2.6",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "next": {
      "sharp": "$sharp"
    },
    "postcss": "$postcss",
    "yaml@2.4.5": "2.9.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
